# Copie para .env.local e preencha. Nunca commite o .env.local.

# --- Supabase ---
# Local: rode `npm run db:start` e copie os valores que aparecem (ou `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor (scripts de importação, admin). Nunca use em código de cliente.
SUPABASE_SECRET_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mapa (Fase 2) ---
# Estilo do MapLibre. OpenFreeMap é gratuito e não precisa de chave.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- IA (Fase 7) ---
ANTHROPIC_API_KEY=

# --- LGPD (obrigatório em produção: o build na Vercel falha sem eles) ---
# Responsável pelo tratamento dos dados e canal de contato, exibidos em /privacidade.
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
